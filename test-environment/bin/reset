#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
if command -v amp >/dev/null 2>&1 \
  && amp orb service list 2>/dev/null | grep -q '^amp-svc-arcadia-test\.service.* active running'; then
  amp orb service stop arcadia-test >/dev/null
fi
sudo docker compose down --remove-orphans
sudo rm -rf state runtime.env
./bin/prepare
echo "Arcadia test environment reset; restart the arcadia-test orb service"
