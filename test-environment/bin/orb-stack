#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

for _ in $(seq 1 60); do
  if sudo docker info >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
sudo docker info >/dev/null

./bin/prepare
set -a
source images.env
set +a

sudo --preserve-env=SLSKD_IMAGE,BEETS_FLASK_IMAGE,JELLYFIN_IMAGE,NEEDLE_TEST_SLSK_USERNAME,NEEDLE_TEST_SLSK_PASSWORD \
  docker compose up -d --remove-orphans slskd beets-flask jellyfin
node ./bin/bootstrap.mjs

exec sudo --preserve-env=PORT,SLSKD_IMAGE,BEETS_FLASK_IMAGE,JELLYFIN_IMAGE \
  docker compose up --build --remove-orphans needle
